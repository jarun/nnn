#!/usr/bin/env sh

# Description: Toggles executable mode for selection
#
# Dependencies: chmod
#
# Note: Works _only_ with selection (nnn can toggle the mode for the hovered file)
#
# Shell: POSIX compliant
# Author: Arun Prakash Jana

selection=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}

if [ -s "$selection" ]; then
    # Keep the script literal so each filename is passed as $1.
    # shellcheck disable=SC2016
    xargs -0 -I {} sh -c 'file=$1; case "$file" in /*) ;; *) file=./$file;; esac; if [ -x "$file" ]; then chmod -x "$file"; else chmod +x "$file"; fi' sh {} < "$selection"

    # Clear selection
    if [ -p "$NNN_PIPE" ]; then
        printf "-" > "$NNN_PIPE"
    fi
fi
