#!/usr/bin/env sh

# Description: List the top N largest files in the directory tree, ignoring
#              files smaller than a minimum size (default: N=20, min=100MB)
#
# Usage:
#   Set N and MINSIZE below (or export NNN_LARGEFILES_N/NNN_LARGEFILES_MINSIZE)
#   to change the defaults. Optionally pass a count as the first argument and
#   a minimum size in MB as the second argument to override for a single run.
#
# Dependencies: find sort head numfmt (optional, for human-readable sizes)
#
# Shell: POSIX compliant
# Author: Arun Prakash Jana

# Default number of files to list, can be overridden by NNN_LARGEFILES_N
N="${NNN_LARGEFILES_N:-20}"
# Minimum file size in MB to consider, can be overridden by NNN_LARGEFILES_MINSIZE
MINSIZE="${NNN_LARGEFILES_MINSIZE:-100}"

case "$1" in
    ''|*[!0-9]*) ;;
    *) N="$1" ;;
esac

case "$2" in
    ''|*[!0-9]*) ;;
    *) MINSIZE="$2" ;;
esac

listing=$(find . -type f -size +"${MINSIZE}"M -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -n "$N")

if [ -z "$listing" ]; then
    printf "No files found\n"
else
    printf "Top %s largest files (> %sMB):\n\n" "$N" "$MINSIZE"
    printf '%s\n' "$listing" | while IFS="$(printf '\t')" read -r size path; do
        if command -v numfmt >/dev/null 2>&1; then
            size=$(numfmt --to=iec-i --suffix=B --padding=7 "$size")
        fi
        printf '%s  %s\n' "$size" "$path"
    done
fi

read -r _
